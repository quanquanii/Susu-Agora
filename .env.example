# Backend
PORT=8787
DATABASE_URL=postgres://susu:susu_dev@localhost:5432/susurration

# Billing toggle (D5 atomic rule)
# 0 during dogfood, 1 after calibration
BILLING_RATE_USD=0

# Solana cluster: devnet during dev, mainnet-beta in prod
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Hot wallet (off-chain ledger settle account, generated lazily on first run)
# In prod: keep PRIVATE KEY in macOS Keychain, NOT in .env
SUSU_HOT_WALLET_PUBKEY=

# Auth
SESSION_SECRET=dev-only-change-me-in-prod
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
